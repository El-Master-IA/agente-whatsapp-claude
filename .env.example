# Obligatorias
ANTHROPIC_API_KEY=        # console.anthropic.com > API Keys (necesita crédito)
ZERNIO_API_KEY=           # zernio.com > Settings > API Keys
ZERNIO_WEBHOOK_SECRET=    # cualquier texto largo y secreto; el mismo en Railway y al conectar

# Opcionales
MODEL=claude-opus-5-5     # o claude-sonnet-5-5 / claude-haiku-5-5 si quieres gastar menos
NOMBRE_AGENTE=Sofía       # cómo se presenta tu agente
MEMORIA_TURNOS=12         # cuántos mensajes recientes recuerda por conversación

# Solo para npm run conectar (en tu computador)
URL_PUBLICA=              # https://tu-app.up.railway.app
MI_WHATSAPP=              # tu número con código de país, ej. +573001234567

# Nivel 2: memoria que sobrevive a reinicios (tu propio proyecto de Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=      # llave secreta (sb_secret_...). Solo va en Railway, nunca en el navegador
